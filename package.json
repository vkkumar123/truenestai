{
  "name": "truenestai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/db-migrate.ts --seed",
    "db:seed:generate": "tsx --conditions=react-server scripts/generate-seed.ts",
    "staff:create": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/create-staff.ts",
    "research:run": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/research-run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
