# TrueNest AI — environment variables. Copy to .env.local and fill in locally.
# NEVER commit real values. All variables below are read server-side only
# (src/server/env.ts); none use the NEXT_PUBLIC_ prefix, so none reach the browser.

# --- Data backend -----------------------------------------------------------
# fixture (default): in-memory, obviously fictional SAMPLE data; no credentials needed.
#   Leads submitted in fixture mode are kept in this server process's memory only
#   (lost on restart, not shared between instances). Development only.
# supabase: Postgres via Supabase. Requires the three SUPABASE_* variables below;
#   the server refuses to start data access without them.
DATA_BACKEND=fixture

# --- Supabase (only when DATA_BACKEND=supabase) -------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Public anon key. Used server-side for public reads (RLS limits it to published data).
SUPABASE_ANON_KEY=
# Service-role key. BYPASSES RLS. Server/worker use only: never expose, log, or prefix
# with NEXT_PUBLIC_. Used for lead storage (clients cannot insert leads directly),
# staff lead operations and worker writes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff sign-in -------------------------------------------------------------
# Secret for signing the dev-only staff session cookie (HMAC-SHA256). >= 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# DEV-ONLY admin password for fixture mode (>= 12 characters). The dev login is refused
# whenever NODE_ENV=production; production staff use Supabase Auth + staff_profiles.
ADMIN_DEV_PASSWORD=

# --- Search -------------------------------------------------------------------
# When fewer researched (Lane A) results than this are found, also query external
# discovery (Lane B, always labelled unverified). Default 3.
MIN_RESEARCHED_RESULTS=3

# --- Lead form rate limit (dev-grade, in-memory per process) -------------------
# Max VALID submissions per window, applied separately per client IP and per contact
# (hashed email/phone). The IP comes from X-Forwarded-For and is trusted only behind a
# proxy that overwrites it (e.g. Vercel). Production needs a shared store.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=600

# --- Tests ----------------------------------------------------------------------
# Local Postgres used by `npm run test:db` (schema is dropped and recreated!).
DATABASE_URL_TEST=postgres://tn_test:tn_test@localhost:5432/truenest_test
# Set to 1 to print structured logs during unit tests.
TN_LOG_IN_TESTS=
