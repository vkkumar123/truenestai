# TrueNest AI — environment variables. Copy to .env.local and fill in locally.
# NEVER commit real values. All variables below are read server-side only
# (src/server/env.ts); none use the NEXT_PUBLIC_ prefix, so none reach the browser.

# --- Data backend -----------------------------------------------------------
# fixture (default): in-memory, obviously fictional SAMPLE data; no credentials needed.
#   Leads submitted in fixture mode are kept in this server process's memory only
#   (lost on restart, not shared between instances). Development only.
# supabase: Postgres via Supabase. Requires the three SUPABASE_* variables below;
#   the server refuses to start data access without them.
DATA_BACKEND=fixture

# --- Supabase (only when DATA_BACKEND=supabase) -------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Public anon key. Used server-side for public reads (RLS limits it to published data).
SUPABASE_ANON_KEY=
# Service-role key. BYPASSES RLS. Server/worker use only: never expose, log, or prefix
# with NEXT_PUBLIC_. Used for lead storage (clients cannot insert leads directly),
# staff lead operations and worker writes.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used ONLY by `npm run db:migrate` / `db:seed` (scripts, not the app).
# Contains the database password: secret. Dashboard → Connect → "Session pooler" (port 5432) or
# direct connection, e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Staff sign-in -------------------------------------------------------------
# Secret for signing the dev-only staff session cookie (HMAC-SHA256). >= 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# DEV-ONLY admin password for fixture mode (>= 12 characters). The dev login is refused
# whenever NODE_ENV=production; production staff use Supabase Auth + staff_profiles.
ADMIN_DEV_PASSWORD=
# Optional DEV-ONLY advisor password (fixture mode) to test role limits: signs in as a
# separate advisor user. >= 12 characters and different from ADMIN_DEV_PASSWORD.
# Also refused when NODE_ENV=production.
ADMIN_DEV_ADVISOR_PASSWORD=

# --- Staff sign-in throttle (dev-grade, in-memory PER INSTANCE) ----------------
# Only FAILED sign-ins count. Max failures per client IP per window; the per-email limit
# (Supabase mode) is 5x this. Counters are per server process: production also relies on
# Supabase Auth rate limits and edge/WAF limits.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900

# --- Search -------------------------------------------------------------------
# When fewer researched (Lane A) results than this are found, also query external
# discovery (Lane B, always labelled unverified). Default 3.
MIN_RESEARCHED_RESULTS=3

# --- Client IP for rate limiting ----------------------------------------------
# Number of trusted proxies that APPEND to X-Forwarded-For in front of the app (integer >= 1).
# The client IP is taken that many entries from the RIGHT; left entries are client-controlled
# and never trusted. 1 = last entry (address seen by the immediate proxy, default).
# Cloud Run behind a Google external load balancer: 2 (client IP is second-from-last).
# Requests without the header share one "unknown" bucket.
TRUSTED_PROXY_HOPS=1

# --- Lead form rate limit (dev-grade, in-memory per process) -------------------
# Max VALID submissions per window, applied separately per client IP (see TRUSTED_PROXY_HOPS)
# and per each contact value given (hashed email, hashed phone). Production needs a shared store.
LEAD_RATE_LIMIT_MAX=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=600

# --- On-demand web research (docs/RESEARCH_WORKER.md) --------------------------
# Only used with DATA_BACKEND=supabase AND once the "anthropic-web-search" source is approved in
# src/discovery/registry.ts for this environment. Fixture mode uses a fake client and never calls
# the network, so none of these are needed for dev, tests or CI.
# Anthropic API key for the research worker. Secret: Secret Manager in production, never committed or logged.
ANTHROPIC_API_KEY=
# Model for research calls. Default: claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Shared secret Cloud Scheduler sends as the x-research-secret header to
# POST /api/internal/research/run. >= 32 characters; while unset (or shorter) the endpoint answers 404.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RESEARCH_RUN_SECRET=
# Hours a finished research job for the same normalised query is reused before researching again.
RESEARCH_CACHE_HOURS=168
# Global cap on research jobs queued per rolling 24 hours (cost guardrail; each job is one API call
# with at most 5 web searches, plus at most one retry).
RESEARCH_MAX_JOBS_PER_DAY=50
# Jobs processed per worker run (processed concurrently, 120 s deadline each).
RESEARCH_BATCH_SIZE=3

# --- Tests ----------------------------------------------------------------------
# Local Postgres used by `npm run test:db` (schema is dropped and recreated!).
DATABASE_URL_TEST=postgres://tn_test:tn_test@localhost:5432/truenest_test
# Set to 1 to print structured logs during unit tests.
TN_LOG_IN_TESTS=
